# The task server, behind something that adds TLS and access control (claude-human task serve
# listens on 127.0.0.1 only). A phone cannot reach 127.0.0.1 on another machine.
EXPO_PUBLIC_TASKS_URL=https://tasks.example.org
EXPO_PUBLIC_TASKS_TOKEN=
# The ntfy topic the task engine announces new tasks on (claude-human task open --ntfy-url).
EXPO_PUBLIC_NTFY_URL=https://ntfy.example.org/tasks
